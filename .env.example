# ──────────────────────────────────────────────────────────────────────────────
# Poultry DSS — Environment Configuration Template
# ──────────────────────────────────────────────────────────────────────────────

# Port to bind the HTTP server to (Default: 80)
PORT=80

# Environment mode ('development' or 'production')
NODE_ENV=development

# ── REQUIRED SECURITY CONFIGURATION ───────────────────────────────────────────
# Session secret used to sign session cookies.
# Generate a strong key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST NOT be empty or have the default value in any environment.
SESSION_SECRET=

# ── TUYA CLOUD TELEMETRY SYNCHRONIZATION ──────────────────────────────────────
# Credentials for the Tuya Smart Cloud API to sync environmental sensor history.
# Required if environmental sync is active.
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TUYA_DEVICE_ID=
# Region code ('eu' for Europe/Africa, 'us' for America, 'cn' for China)
TUYA_REGION=eu

# ── TELEGRAM SENSOR ALERTS ────────────────────────────────────────────────────
# Telegram Bot integration for sensor offline/welfare alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── END-TO-END AUTOMATED TESTING ──────────────────────────────────────────────
# Password seed for database reset and testing automation login.
E2E_TEST_PASSWORD=

# ── M-PESA DARAJA API CONFIGURATION ───────────────────────────────────────────
# NOTE: M-Pesa STK Push credentials (Consumer Key, Consumer Secret, Shortcode, 
# and Passkey) are configured directly through the Settings interface in the 
# Web UI. They are stored securely in the SQLite database `entities` table 
# rather than as environment variables.
#
# Web settings mapped:
# - mpesa_shortcode       -> Paybill or Store number (e.g., 174379)
# - mpesa_passkey         -> LNM Online Passkey
# - mpesa_consumer_key    -> Daraja App Consumer Key
# - mpesa_consumer_secret -> Daraja App Consumer Secret
